# Copy this file to .env.local and fill in real values.
# .env.local is never uploaded to GitHub (it's in .gitignore) — keep secrets here only.

# --- Database (Supabase — free tier) ---
# Get these from https://supabase.com -> your project -> Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Use the "service_role" key, NOT the "anon" key — this is used for all admin
# and order database access from the server. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# These two are the SAME project, but the public-safe "anon" key — used for
# customer login (email/password + Google) in the browser. Safe to expose;
# Supabase Auth is designed for this key to be public.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google sign-in (optional, free) ---
# To enable the "Continue with Google" button:
#   1. console.cloud.google.com -> create a free project (no billing needed)
#   2. APIs & Services -> Credentials -> Create OAuth client ID (type: Web)
#   3. Add this Authorized redirect URI: https://<your-supabase-project>.supabase.co/auth/v1/callback
#   4. Copy the Client ID + Secret into Supabase: Authentication -> Providers -> Google
# No env vars needed here — Google login is configured entirely in Supabase's dashboard.

# --- Admin panel ---
# Pick your own password for /admin. Change this from the default before sharing the app.
ADMIN_PASSWORD=change-this-password
# A random string used to sign the admin login cookie. Any long random text works.
# Generate one at https://www.uuidgenerator.net or just mash your keyboard for 40+ characters.
SESSION_SECRET=replace-with-a-long-random-string

# --- Claude API (for generating the itinerary narrative) ---
# Get this from https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model to use. claude-sonnet-5 is the default (good quality/cost balance).
ANTHROPIC_MODEL=claude-sonnet-5

# --- Razorpay (for payments) ---
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys
# Use your TEST keys while building, LIVE keys only when you're ready to accept real money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# The key id also needs to be public (browser-visible) so Razorpay's checkout popup can use it.
# It's safe to expose the KEY ID (not the SECRET) publicly — that's how Razorpay is designed.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# --- Testing bypasses (Phase 1 only — remove/set to false before going live) ---
# When true, skips the real Razorpay checkout popup and pretends payment succeeded.
# Lets you test the whole flow — including the AI itinerary — for ₹0.
NEXT_PUBLIC_SKIP_PAYMENT=true

# When true, the itinerary API will respond even if no valid payment reference is attached.
# Belt-and-braces version of the bypass above, checked on the server side.
ALLOW_UNPAID_REQUESTS=true
